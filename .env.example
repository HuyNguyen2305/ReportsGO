# Copy to .env (git-ignored) and fill in real credentials.
# Only DATABASE_URL is required; every other variable shows its default.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/Reports?sslmode=disable
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# Server-side timeout applied to every query.
# DB_STATEMENT_TIMEOUT=5s

# --- HTTP server --------------------------------------------------------------
# HTTP_ADDR=:8080
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# Time allowed for in-flight requests to finish on shutdown.
# SHUTDOWN_TIMEOUT=15s
# Comma-separated exact origins (scheme://host[:port]); empty means same-origin only. "*" is not allowed.
# CORS_ALLOWED_ORIGINS=https://reports.example.com,http://localhost:3000
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted; empty trusts none.
# TRUSTED_PROXIES=10.0.0.0/8

# --- Logging ------------------------------------------------------------------
# APP_ENV=dev           # dev = text logs, prod = JSON logs
# Business time zone (IANA name). Decides which calendar month is "current" for the reports' default date range.
# APP_TIMEZONE=UTC      # e.g. America/New_York
# LOG_LEVEL=info        # debug | info | warn | error

# --- Tests ----------------------------------------------------------------------
# Role used by integration tests; must be allowed to CREATE/DROP DATABASE.
TEST_POSTGRES_URL=postgres://USER:PASSWORD@localhost:5432/postgres?sslmode=disable
